{
  "name": "store-desktop",
  "version": "2.0.1",
  "description": "Application de gestion de boutique d’épices et arômes",
  "author": "VIBE",
  "main": "dist/backend/main/index.js",
  "type": "module",
  "scripts": {
    "native:electron": "node scripts/ensure-electron-native.mjs",
    "native:node": "npm rebuild better-sqlite3",
    "predev": "npm run native:electron",
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 dist/backend/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/launch-electron.mjs\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prestart": "npm run native:electron",
    "start": "node scripts/launch-electron.mjs",
    "pretest": "npm run native:node",
    "test": "vitest run --root .",
    "pretest:watch": "npm run native:node",
    "test:watch": "vitest --root .",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run build && electron-builder && npm run verify:package",
    "package:win:x64": "npm run build && electron-builder --win --x64 && npm run verify:package",
    "package:win:arm64": "npm run build && electron-builder --win --arm64 && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.47.0",
    "nodemailer": "9.1.1",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^17.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "4.1.11",
    "wait-on": "^9.0.10"
  }
}
